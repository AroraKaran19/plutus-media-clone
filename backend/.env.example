# Server
NODE_ENV=development
PORT=5000
VERSION=1.0.0

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/plutus-media

# Auth: JWT_SECRET must be at least 16 characters
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary: from your dashboard at cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=plutus-media

# Cache busting. Must match the frontend's REVALIDATE_SECRET. Optional.
FRONTEND_REVALIDATE_URL=http://localhost:3000/revalidate
REVALIDATE_SECRET=
