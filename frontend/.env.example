# Where the Express API lives. Next proxies /api/* here.
BACKEND_URL=http://localhost:5000

# Must match the backend's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Cloudinary: the browser needs these to run the upload widget.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_FOLDER=plutus-media
